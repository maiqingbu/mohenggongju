{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "fs:default",
      "allow": [{ "path": "$APPDATA/novel-studio" }, { "path": "$APPDATA/novel-studio/**" }]
    },
    {
      "identifier": "fs:write-all",
      "allow": [{ "path": "$APPDATA/novel-studio" }, { "path": "$APPDATA/novel-studio/**" }]
    }
  ]
}
